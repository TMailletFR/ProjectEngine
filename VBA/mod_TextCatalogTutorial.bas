Attribute VB_Name = "mod_TextCatalogTutorial"
Option Explicit

Public Function TextCatalogTutorial_Definitions() As Variant
    Dim items(0 To 104) As Variant
    items(0) = Array("TUTORIAL.TITLE", "ProjectEngine tutorial", "Tutoriel ProjectEngine")
    items(1) = Array("TUTORIAL.LABEL", "Tutorial", "Tutoriel")
    items(2) = Array("TUTORIAL.TIP", "Discover the interface or learn by building your own schedule.", "Découvrez l'interface ou apprenez à construire votre planning.")
    items(3) = Array("TUTORIAL.PREVIOUS", "Previous", "Précédent")
    items(4) = Array("TUTORIAL.NEXT", "Next", "Suivant")
    items(5) = Array("TUTORIAL.CLOSE", "Close", "Fermer")
    items(6) = Array("TUTORIAL.FINISH", "Finish", "Terminer")
    items(7) = Array("TUTORIAL.RESUME", "Resume", "Reprendre")
    items(8) = Array("TUTORIAL.RESTART", "Restart", "Recommencer")
    items(9) = Array("TUTORIAL.RESUME.MESSAGE", "Resume your visit or start again from the first page.", "Reprenez votre visite ou recommencez depuis la première page.")
    items(10) = Array("TUTORIAL.COMPLETED", "You have completed this tutorial. You can revisit the last page or start again.", "Vous avez terminé ce tutoriel. Vous pouvez revoir la dernière page ou recommencer.")
    items(11) = Array("TUTORIAL.VERSION.CHANGED", "The tutorial has changed. Your visit restarts from the first page.", "Le tutoriel a changé. Votre visite reprend à la première page.")
    items(12) = Array("TUTORIAL.FALLBACK", "This view will contain your project's results after its normal update command.", "Cette vue contiendra les résultats de votre projet après sa commande d'actualisation habituelle.")
    items(13) = Array("TUTORIAL.NAVIGATION.TITLE", "WBS: your project starts here", "WBS : le point de départ de votre projet")
    items(14) = Array("TUTORIAL.NAVIGATION.BODY", "Your workspace\nWBS is the task list you fill in. One row represents one activity or milestone.\n\nThe result\nProjectEngine uses these inputs to calculate dates, draw the Gantt and build progress views. Start with the task list, not the chart.", "Votre espace de saisie\nWBS contient les tâches de votre projet. Une ligne représente une activité ou un jalon.\n\nLe résultat\nCes entrées servent à calculer les dates, dessiner le Gantt et produire les vues d'avancement. Commencez par la liste des tâches, pas par le graphique.")
    items(15) = Array("TUTORIAL.WBS_STRUCTURE.TITLE", "Build the WBS", "Construire le WBS")
    items(16) = Array("TUTORIAL.WBS_STRUCTURE.BODY", "Identify the task\n{TaskID} is the task identifier. It is not its WBS code.\n\nBuild the hierarchy\nWBS describes its place in the project: 1.1 is a parent of 1.1.1. Keep each child's code beneath the appropriate parent.\n\nSummary tasks\nTheir dates are calculated from their children; do not schedule a parent as a separate activity.", "Identifier la tâche\n{TaskID} est l'identifiant de la tâche. Ce n'est pas son code WBS.\n\nConstruire la hiérarchie\nWBS indique sa place dans le projet : 1.1 est parent de 1.1.1. Organisez les codes des enfants sous le parent correspondant.\n\nTâches de synthèse\nLeurs dates sont calculées à partir des enfants ; ne planifiez pas un parent comme une activité indépendante.")
    items(17) = Array("TUTORIAL.CONFIGURATION.TITLE", "Choose task calendars and types", "Choisir les calendriers et types de tâches")
    items(18) = Array("TUTORIAL.CONFIGURATION.BODY", "Where\nUse {Cal} and {TaskType} in WBS.\n\nChoose\n5/7, 6/7 or 7/7 sets the working calendar. Choose an ordinary task, milestone or accompanying activity (Level of Effort).\n\nWhy\nThese choices affect date calculation and how the task appears in the Gantt.", "Où\nDans WBS, utilisez {Cal} et {TaskType}.\n\nChoisir\n5/7, 6/7 ou 7/7 définit le calendrier de travail. Choisissez une tâche ordinaire, un jalon ou une activité d'accompagnement (valeur Level of Effort).\n\nPourquoi\nCes choix influencent les dates calculées et la représentation dans le Gantt.")
    items(19) = Array("TUTORIAL.DATES.TITLE", "Manage dates", "Gérer les dates")
    items(20) = Array("TUTORIAL.DATES.BODY", "Original plan\nEnter the initial plan in {BaselineStart} and {BaselineDuration}.\n\nRevised and actual dates\nUse {ForecastStart} / {ForecastFinish} for revised dates, and {ActualStart} / {ActualFinish} for what has actually happened.\n\nPriority\nActual dates take priority over forecast dates, then baseline dates. Dependencies and constraints still bound the result. The calculated outputs are read after updating scheduling.", "Plan initial\nRenseignez le plan initial dans {BaselineStart} et {BaselineDuration}.\n\nPrévision et réel\nUtilisez {ForecastStart} / {ForecastFinish} pour les dates révisées, et {ActualStart} / {ActualFinish} pour ce qui a réellement eu lieu.\n\nPriorité\nLes dates réelles priment sur les dates prévisionnelles, puis sur la référence. Dépendances et contraintes restent des bornes du résultat. Les sorties calculées se lisent après actualisation du planning.")
    items(21) = Array("TUTORIAL.DEPENDENCIES.TITLE", "Create dependencies", "Créer les dépendances")
    items(22) = Array("TUTORIAL.DEPENDENCIES.BODY", "Where\nEnter predecessor WBS codes in {Predecessors}. Separate several predecessors with ;.\n\nLink types\nFS: finish to start. SS: start to start. FF: finish to finish. A positive or negative lag offsets the link.\n\nResult\nCalculation applies the sequence; the Gantt draws the dependency links.", "Où\nSaisissez les codes WBS des prédécesseurs dans {Predecessors}. Séparez plusieurs prédécesseurs par ;.\n\nTypes de liens\nFS : fin-début. SS : début-début. FF : fin-fin. Un décalage positif ou négatif avance ou retarde le lien.\n\nRésultat\nLe calcul applique l'enchaînement ; le Gantt dessine les dépendances.")
    items(23) = Array("TUTORIAL.CONSTRAINTS.TITLE", "Manage constraints", "Gérer les contraintes")
    items(24) = Array("TUTORIAL.CONSTRAINTS.BODY", "For advanced scheduling\nFind the task by its WBS and name in CONSTRAINTS. Row 1 explains the columns; hover over its help cells. Headers are on row 2 and activities start on row 3.\n\nEnter a rule\nChoose a start or finish constraint type and its date. Use a rule only when there is a real requirement.\n\nCheck\nRecalculate and read the messages: a rule can conflict with dependencies or actual dates.", "Pour aller plus loin\nRetrouvez la tâche par son WBS et son nom dans CONSTRAINTS. La ligne 1 explique les colonnes : survolez ses aides. Les en-têtes sont en ligne 2 et les activités commencent en ligne 3.\n\nSaisir une règle\nChoisissez un type de contrainte de début ou de fin, puis sa date. Ajoutez une règle seulement si elle répond à un besoin réel.\n\nVérifier\nRecalculez et lisez les messages : une règle peut contredire les dépendances ou le réalisé.")
    items(25) = Array("TUTORIAL.CALCULATION.TITLE", "Calculate the schedule", "Calculer le planning")
    items(26) = Array("TUTORIAL.CALCULATION.BODY", _
        "{UpdatePlanning}\nAfter editing the task inputs, use this WBS command for the normal scheduling update. It is not a partial engine calculation.\n\n{ForcedUpdate}\nForces scheduling to recalculate when needed. It is not the combined scheduling and S-Curve workflow.\n\nCheck the result\nRead the business messages before relying on the resulting dates. In Practice, {Next} asks to run {UpdatePlanning}. In Discovery, it never calculates.", _
        "{UpdatePlanning}\nAprès modification des entrées des tâches, utilisez cette commande WBS pour la mise à jour normale du planning. Ce n'est pas un calcul partiel du moteur.\n\n{ForcedUpdate}\nForce le recalcul du planning lorsque nécessaire. Ce n'est pas le parcours combiné planning et S-Curve.\n\nVérifier le résultat\nLisez les messages métier avant de vous appuyer sur les dates obtenues. En pratique, {Next} propose {UpdatePlanning}. En découverte, il ne calcule jamais.")
    items(27) = Array("TUTORIAL.GANTT.TITLE", "Explore the Gantt", "Explorer le Gantt")
    items(28) = Array("TUTORIAL.GANTT.BODY", "Left: which task and when?\nFind its name, {Start} and {Finish}. These dates are calculated from the WBS inputs.\n\nRight: how does it fit?\nA bar shows an activity, a summary spans its children and a diamond marks a milestone. Arrows show dependencies.\n\nRead together\nFollow the same row from its name to its graphic.", "À gauche : quelle tâche, quand ?\nRetrouvez son nom, {Start} et {Finish}. Ces dates sont calculées à partir des entrées WBS.\n\nÀ droite : comment s'enchaîne-t-elle ?\nUne barre représente une activité, une synthèse couvre ses enfants et un losange marque un jalon. Les flèches montrent les dépendances.\n\nLire ensemble\nSuivez la même ligne, du nom au graphique.")
    items(29) = Array("TUTORIAL.SCENARIOS.TITLE", "Test scenarios", "Tester des scénarios")
    items(30) = Array("TUTORIAL.SCENARIOS.BODY", "Where\nThe yellow {TestStart} and {TestFinish} cells are in GANTT. {TestProgress} lets you try progress changes.\n\nSimulate\nEnter the changes you want to examine, then run {Test} from the Gantt Ribbon.\n\nNot yet committed\nCompare the simulated result before deciding whether to keep it. This tutorial does not change these cells.", "Où\nLes cellules jaunes {TestStart} et {TestFinish} sont dans GANTT. {TestProgress} permet d'essayer un autre avancement.\n\nSimuler\nRenseignez les changements à étudier, puis lancez {Test} dans le ruban Gantt.\n\nPas encore appliqué\nComparez le résultat simulé avant de décider de le conserver. Le tutoriel ne modifie pas ces cellules.")
    items(31) = Array("TUTORIAL.ANALYSIS.TITLE", "Analyse the schedule", "Analyser le planning")
    items(32) = Array("TUTORIAL.ANALYSIS.BODY", "Read in WBS after calculation\n{CriticalPath} identifies sensitive tasks. {TotalFloat} and {FreeFloat} show available slack.\n\nCurrent and REX\nKeep the normal columns separate from the columns marked REX; they represent different analyses.\n\nInvestigate\nFor negative slack, inspect the task dates, dependencies and messages before making a decision.", "Lire dans WBS après calcul\n{CriticalPath} identifie les tâches sensibles. {TotalFloat} et {FreeFloat} indiquent les marges disponibles.\n\nPlanning courant et REX\nDistinguez les colonnes normales de celles marquées REX : elles correspondent à des analyses différentes.\n\nComprendre\nFace à une marge négative, examinez dates, dépendances et messages avant de décider.")
    items(33) = Array("TUTORIAL.MONITORING.TITLE", "Monitor and steer", "Suivre et piloter")
    items(34) = Array("TUTORIAL.MONITORING.BODY", "Select two states\nChoose the earlier snapshot in {From} and the later one in {To}.\n\n{Compare}\nUse this button to compare the selected states.\n\nRead the changes\nThe comparison shows what changed between those states; it is not a live recalculation of your task list.", "Choisir deux états\nChoisissez l'instantané précédent dans {From} et le plus récent dans {To}.\n\n{Compare}\nUtilisez ce bouton pour comparer les deux états sélectionnés.\n\nLire les écarts\nLa comparaison montre ce qui a changé entre ces états ; elle ne recalcule pas votre liste de tâches.")
    items(35) = Array("TUTORIAL.EMPTY.STATUS", "If the described result is absent or hidden, use its normal command when you need it; the visit never builds it silently.", "Si le résultat décrit est absent ou masqué, utilisez sa commande habituelle lorsque vous en avez besoin ; la visite ne le construit jamais silencieusement.")
    items(36) = Array("TUTORIAL.SAVE.BLOCKED", "The tutorial highlight could not be removed. Close the tutorial and check sheet protection before saving again.", "Le surlignage du tutoriel n'a pas pu être retiré. Fermez le tutoriel et vérifiez la protection de la feuille avant de réessayer l'enregistrement.")
    items(37) = Array("TUTORIAL.DISPLAY.TITLE", "Set display preferences", "Régler les préférences d'affichage")
    items(38) = Array("TUTORIAL.DISPLAY.BODY", "Where\nOpen {Settings} from the global Ribbon.\n\nChoose\nSet the global language and date format. The individual views also have their own language controls.\n\nNot a task calendar\nThese settings change presentation. Task calendars are entered in the WBS {Cal} column.", "Où\nOuvrez {Settings} depuis le ruban général.\n\nChoisir\nRéglez la langue globale et le format des dates. Les différentes vues possèdent aussi leurs contrôles de langue.\n\nPas un calendrier de tâche\nCes réglages concernent l'affichage. Les calendriers des tâches se renseignent dans {Cal} du WBS.")
    items(39) = Array("TUTORIAL.DEADLINE.TITLE", "Monitor a deadline", "Surveiller une échéance")
    items(40) = Array("TUTORIAL.DEADLINE.BODY", "Where\nFind your task in CONSTRAINTS and enter its due date in {Deadline}.\n\nPurpose\nMonitor the gap between the calculated finish and this deadline.\n\nDistinguish\nA deadline is not the same input as a start or finish constraint. Recalculate and check the resulting slack and messages.", "Où\nRetrouvez votre tâche dans CONSTRAINTS et renseignez son échéance dans {Deadline}.\n\nObjectif\nSurveillez l'écart entre sa fin calculée et cette échéance.\n\nDistinguer\nUne échéance n'est pas une contrainte de début ou de fin. Recalculez et vérifiez les marges et messages obtenus.")
    items(41) = Array("TUTORIAL.GANTT_NAVIGATION.TITLE", "Find your way around the Gantt", "Se repérer dans le Gantt")
    items(42) = Array("TUTORIAL.GANTT_NAVIGATION.BODY", "GANTT ribbon\n{FullTimeline} frames the visible schedule.\n\nFind a task\nSelect its bar, then use {SelectedTask} to return to its position.\n\nKeep your bearings\nUse the name and dates on the left to confirm which activity you are examining.", "Ruban GANTT\n{FullTimeline} cadre le planning visible.\n\nRetrouver une tâche\nSélectionnez sa barre, puis utilisez {SelectedTask} pour retrouver sa position.\n\nGarder le contexte\nLe nom et les dates à gauche permettent de confirmer l'activité que vous examinez.")
    items(43) = Array("TUTORIAL.SCENARIO_COMMIT.TITLE", "Keep or discard a simulation", "Conserver ou abandonner une simulation")
    items(44) = Array("TUTORIAL.SCENARIO_COMMIT.BODY", "{Lock}\nAfter validation, changed test dates become WBS forecast dates, and changed progress is applied to WBS. With an active scenario, {Lock} creates scenario planning.\n\n{GanttReset}\nLeave the simulation.\n\nDo not confuse\n{ResetPlanning} and {FullReset} are separate commands; {FullReset} empties the project.", "{Lock}\nAprès vérification, les dates test modifiées deviennent des dates prévisionnelles dans WBS, et l'avancement modifié y est appliqué. En scénario actif, {Lock} crée un planning de scénario.\n\n{GanttReset}\nQuittez la simulation.\n\nNe pas confondre\n{ResetPlanning} et {FullReset} sont distincts ; la réinitialisation complète vide le projet.")
    items(45) = Array("TUTORIAL.SCURVE.TITLE", "Read project progress in S-Curve", "Lire l'avancement dans S-Curve")
    items(46) = Array("TUTORIAL.SCURVE.BODY", "Where\nOpen SCURVE after updating its calculation.\n\nRead the curves\n{Baseline} is the reference plan. {Actual} shows achieved progress. {Forecast} shows the remaining trajectory.\n\nCompare\nAt the same date, compare planned and achieved progress. The curves depend on the WBS dates, weights and progress entered earlier.", "Où\nOuvrez SCURVE après actualisation de son calcul.\n\nLire les courbes\n{Baseline} représente le plan initial. {Actual} montre l'avancement obtenu. {Forecast} montre la trajectoire restante.\n\nComparer\nÀ une même date, comparez le prévu et le réalisé. Les courbes dépendent des dates, poids et avancements saisis dans WBS.")
    items(47) = Array("TUTORIAL.HISTORY.TITLE", "Find and understand messages", "Retrouver et comprendre les messages")
    items(48) = Array("TUTORIAL.HISTORY.BODY", "Where\nOpen EVENT_HISTORY to find calculation messages after closing the console.\n\nRead\nUse severity and the message to identify the task or input to check. Correct the cause in the relevant sheet.\n\nAcknowledge\nAcknowledgement records that a message was reviewed; it does not correct the planning data.", "Où\nOuvrez EVENT_HISTORY pour retrouver les messages de calcul après fermeture de la console.\n\nLire\nLa gravité et le message indiquent la tâche ou l'entrée à vérifier. Corrigez la cause dans la feuille concernée.\n\nAcquitter\nL'acquittement indique qu'un message a été examiné ; il ne corrige pas les données du planning.")
    items(49) = Array("TUTORIAL.WEIGHTS.TITLE", "Prepare inputs for the S-Curve", "Préparer les entrées de la S-Curve")
    items(50) = Array("TUTORIAL.WEIGHTS.BODY", "Enter in WBS\n{Weight} defines a leaf task's share of project progress. {Progress} records how much of it is complete.\n\nEligibility\nFill positive weights on eligible activities. Missing weights exclude tasks; milestones and Level of Effort do not contribute.\n\nThen calculate\nUse {UpdateSCurve} or {FullUpdate} to produce the curves from these inputs and dates.", "Saisir dans WBS\n{Weight} définit la contribution d'une tâche feuille à l'avancement du projet. {Progress} indique son avancement.\n\nPrise EN compte\nRenseignez des poids positifs sur les activités éligibles. Un poids absent exclut la tâche ; les jalons et activités d'accompagnement ne contribuent pas.\n\nPuis calculer\n{UpdateSCurve} ou {FullUpdate} produit les courbes à partir de ces entrées et des dates.")
    items(51) = Array("TUTORIAL.GENERAL.TITLE", "The commands available everywhere", "Les commandes disponibles partout")
    items(52) = Array("TUTORIAL.GENERAL.BODY", "Available from every sheet\n{Settings}, {Import} and {Tutorial} do not require WBS or GANTT to be active.\n\nGlobal navigation\n{FullTimeline} and {SelectedTask} are also available from every sheet. Their existing checks decide whether a Gantt or task can actually be shown.\n\nReset commands\nRead each confirmation: {FullReset} empties the project and clears both tutorial bookmarks. It is not the command for leaving a Gantt simulation.", "Disponibles depuis chaque feuille\n{Settings}, {Import} et {Tutorial} ne demandent pas que WBS ou GANTT soit actif.\n\nNavigation globale\n{FullTimeline} et {SelectedTask} sont également accessibles depuis chaque feuille. Leurs contrôles habituels déterminent si un Gantt ou une tâche peut effectivement être affiché.\n\nRéinitialisation\nLisez les confirmations : {FullReset} vide le projet et efface les deux progressions du tutoriel. Ce n'est pas la commande de sortie d'une simulation Gantt.")
    items(53) = Array("TUTORIAL.SUMMARY_SELECTION.TITLE", "Choose what Summary will display", "Choisir ce que Summary affichera")
    items(54) = Array("TUTORIAL.SUMMARY_SELECTION.BODY", "Prepare in WBS\nUse the S column to choose the rows for the summary view.\n\nY or N\nY keeps the row visible in the summary; N excludes it. This can include an activity or milestone, not only a parent task.\n\nNext\nThe Gantt selector {View} switches between the detailed view and this selection.", "Préparer dans WBS\nLa colonne S choisit les lignes de la vue synthétique.\n\nY ou N\nY conserve la ligne en synthèse ; N l'exclut. Cela peut concerner une activité ou un jalon, pas seulement un parent.\n\nEnsuite\nDans GANTT, le sélecteur {View} permet de passer du détail à cette sélection.")
    items(55) = Array("TUTORIAL.GANTT_CONTROLS.TITLE", "Use the Gantt view selectors", "Utiliser les sélecteurs de vue du Gantt")
    items(56) = Array("TUTORIAL.GANTT_CONTROLS.BODY", "{View}\nThe detailed view shows task detail. The summary keeps the WBS rows marked S = Y.\n\n{Scale}\nChange the time scale for a close view or a wider overview.\n\n{ConstraintView}\nShow or hide constraint markers. These view controls do not replace the dates or dependencies entered in WBS.", "{View}\nLa vue détaillée montre les tâches. La synthèse conserve les lignes WBS marquées S = Y.\n\n{Scale}\nChangez l'échelle de temps pour examiner le détail ou prendre du recul.\n\n{ConstraintView}\nAffichez ou masquez les marqueurs de contraintes. Ces contrôles de vue ne remplacent pas les dates et dépendances saisies dans WBS.")
    items(57) = Array("TUTORIAL.GANTT_PATHS.TITLE", "Choose how to view critical paths", "Choisir comment lire les chemins critiques")
    items(58) = Array("TUTORIAL.GANTT_PATHS.BODY", "{Paths}\nChoose the path emphasis to display. The first choice removes that emphasis.\n\n{MultiProject}\nThe first choice uses a global finish reference; the second uses the finish of each connected task network.\n\nImportant\nThis affects path analysis; it is not a filter on the WBS Project column.", "{Paths}\nChoisissez la mise en évidence des chemins. Le premier choix la désactive.\n\n{MultiProject}\nLe premier choix utilise une fin de référence globale ; le second utilise la fin de chaque réseau de tâches liées.\n\nImportant\nCe choix agit sur l'analyse des chemins ; il ne filtre pas les tâches par leur projet.")
    items(59) = Array("TUTORIAL.PROJECTIONS.TITLE", "Use the complete update", "Utiliser la mise à jour complète")
    items(60) = Array("TUTORIAL.PROJECTIONS.BODY", "{FullUpdate}\nRecalculates scheduling and analyses, then updates the planned outputs including S-Curve. Prepare dates, weights and progress first.\n\nGANTT\nIts physical display can still be pending. The separate {UpdateGantt} command is explained before visiting the chart.\n\nPractice\nNext explicitly proposes {FullUpdate}. A warning allows progress; a blocking error keeps this step open while you correct the inputs.", "{FullUpdate}\nRecalcule le planning et les analyses, puis actualise les restitutions prévues dont la S-Curve. Préparez d'abord dates, poids et avancement.\n\nGANTT\nSon affichage physique peut encore être en attente. La commande distincte {UpdateGantt} sera expliquée avant la visite du graphique.\n\nPratique\nSuivant propose explicitement {FullUpdate}. Un avertissement permet d'avancer ; une erreur bloquante maintient cette étape pendant la correction des entrées.")
    items(61) = Array("TUTORIAL.DASHBOARD_CAPTURE.TITLE", "Keep a snapshot for your next review", "Conserver un instantané pour le prochain suivi")
    items(62) = Array("TUTORIAL.DASHBOARD_CAPTURE.BODY", "{NewSnapshot}\nThis optional Dashboard button runs a complete update, then keeps a snapshot of the resulting project. It can take time; use it deliberately.\n\nWhen\nKeep an important reporting date or decision state for later comparison. {Next} does not require you to create a snapshot.\n\nNext\n{From} and {To} let you compare two retained states; the next page explains them.", "{NewSnapshot}\nCe bouton facultatif du Dashboard lance une mise à jour complète, puis conserve un instantané du projet obtenu. Il peut prendre du temps ; utilisez-le volontairement.\n\nQuand\nGardez un état à une date de suivi ou avant une décision pour une comparaison ultérieure. {Next} ne vous oblige pas à créer un instantané.\n\nEnsuite\n{From} et {To} permettent de comparer deux états conservés ; la page suivante les explique.")
    items(63) = Array("TUTORIAL.LANGUAGE.GLOBAL", "Language of the tutorial and workbook", "Langue du tutoriel et du classeur")
    items(64) = Array("TUTORIAL.LANGUAGE.READONLY", "Read-only: workbook language cannot be changed", "Lecture seule : la langue du classeur ne peut pas être modifiée")
    items(65) = Array("TUTORIAL.LANGUAGE.FAILED", "Language could not be changed. The previous setting was retained.", "La langue n'a pas pu être modifiée. Le réglage précédent est conservé.")
    items(66) = Array("TUTORIAL.WBS_NAMES.TITLE", "Name the activities", "Nommer les activités")
    items(67) = Array("TUTORIAL.WBS_NAMES.BODY", "{TaskName}\nUse a short, recognisable activity name. The Gantt reuses this name so that you can identify the same task in both views.\n\nOne row, one role\nDistinguish an activity from a parent that groups activities. Keep the detailed work on child rows; the parent summarises it.", "{TaskName}\nDonnez un nom court et reconnaissable à l'activité. Le Gantt reprend ce nom pour retrouver la même tâche dans les deux vues.\n\nUne ligne, un rôle\nDistinguez une activité d'un parent qui regroupe des activités. Décrivez le travail détaillé sur les lignes enfants ; le parent en fait la synthèse.")
    items(68) = Array("TUTORIAL.DATES_RESULT.TITLE", "Read the calculated dates", "Lire les dates calculées")
    items(69) = Array("TUTORIAL.DATES_RESULT.BODY", _
        "The result\n{CalculatedStart}, {CalculatedFinish} and {CalculatedDuration} show the scheduling result. They are calculated outputs, not dates to enter manually.\n\nFrom WBS to GANTT\nThe Gantt uses the calculated start and finish to position each task bar. If a bar's dates surprise you, compare these outputs with the input dates and dependencies.\n\nBefore calculating\nOn an empty planning, the headers identify where these results will appear after a scheduling update.", _
        "Le résultat\n{CalculatedStart}, {CalculatedFinish} et {CalculatedDuration} montrent le résultat du calcul du planning. Ce sont des sorties calculées, pas des dates à saisir.\n\nDu WBS au GANTT\nLe Gantt utilise le début et la fin calculés pour positionner chaque barre. Si ses dates vous surprennent, comparez ces sorties aux dates saisies et aux dépendances.\n\nAvant le premier calcul\nSur un planning vierge, les en-têtes indiquent où ces résultats apparaîtront après une actualisation du planning.")
    items(70) = Array("TUTORIAL.CLOSE.RETRY", "Excel has not finished closing the tutorial. Wait a moment, then close this workbook again. No automatic save was made.", "Excel n'a pas encore terminé la fermeture du tutoriel. Patientez un instant, puis fermez de nouveau ce classeur. Aucune sauvegarde automatique n'a été effectuée.")
    items(71) = Array("TUTORIAL.HOME", "Home", "Accueil")
    items(72) = Array("TUTORIAL.HOME.TITLE", "Choose how to learn ProjectEngine", "Choisissez comment découvrir ProjectEngine")
    items(73) = Array("TUTORIAL.HOME.BODY", "Your workbook\nDiscovery explains the existing interface without requiring inputs. Practice lets you edit your real schedule and explicitly run the usual commands.\n\nYour progress\nEach mode keeps its own bookmark. Nothing is saved automatically.", "Votre classeur\nLa découverte explique l'interface existante sans saisie obligatoire. La pratique vous laisse renseigner votre vrai planning et lancer explicitement les commandes habituelles.\n\nVotre progression\nChaque mode conserve son propre repère. Rien n'est enregistré automatiquement.")
    items(74) = Array("TUTORIAL.DISCOVERY.CHOICE", "Simplified mode - discover" & vbCrLf & vbCrLf & "Explore WBS, Gantt, S-Curve, Dashboard, EventHistory, Constraints and optional Finance, with no required inputs or business action. Yellow highlights the areas to observe. If a result is absent, the visit explains what will appear there. {Previous} and {Next} remain free: they never launch a calculation.", "Mode simplifié - découvrir" & vbCrLf & vbCrLf & "Parcourez WBS, Gantt, S-Curve, Dashboard, EventHistory, Constraints et le suivi Finance facultatif, sans saisie obligatoire ni action métier. Le jaune montre les zones à observer. Si un résultat est absent, la visite explique ce qui y apparaîtra. {Previous} et {Next} restent libres : ils ne lancent aucun calcul.")
    items(75) = Array("TUTORIAL.PRACTICE.CHOICE", "Interactive mode - learn by practising" & vbCrLf & vbCrLf & "Build your own schedule. Edit inside the green outlines; yellow areas explain the results. When an operation is needed, {Next} asks to run the usual command with its existing checks and message console. Success or nonblocking warnings allow progress; blocking errors keep the step open for correction and retry.", "Mode interactif - apprendre EN pratiquant" & vbCrLf & vbCrLf & "Construisez votre planning. Renseignez les cadres verts ; les zones jaunes expliquent les résultats. Lorsqu'une opération est nécessaire, {Next} propose la commande habituelle avec ses contrôles et sa console de messages. Une réussite ou un avertissement non bloquant permet d'avancer ; une erreur bloquante maintient l'étape pour corriger et réessayer.")
    items(76) = Array("TUTORIAL.DISCOVERY.LABEL", "Discovery", "Découverte")
    items(77) = Array("TUTORIAL.PRACTICE.LABEL", "Practice", "Pratique")
    items(78) = Array("TUTORIAL.HOME.STATUS", "Each mode keeps its own bookmark. No automatic save. Full reset clears both bookmarks.", "Chaque mode conserve sa progression. Aucune sauvegarde automatique. La réinitialisation complète efface les deux progressions.")
    items(79) = Array("TUTORIAL.RESIZE", "Resize the tutorial", "Redimensionner le tutoriel")
    items(80) = Array("TUTORIAL.PRACTICE.EDIT", "Green outline: edit the cells or try the real control inside it. Next does not validate your inputs; the normal command does.", "Contour vert : renseignez les cellules ou essayez le vrai contrôle à l'intérieur. Suivant ne valide pas vos saisies ; la commande habituelle s'en charge.")
    items(81) = Array("TUTORIAL.PRACTICE.OBSERVE", "Observe this result. On a calculation step, Next asks before running the usual command.", "Observez ce résultat. À une étape de calcul, Suivant demande votre accord avant de lancer la commande habituelle.")
    items(82) = Array("TUTORIAL.DISCOVERY.STATUS", "Discovery: no calculation is launched by Next. Yellow identifies the zone to observe.", "Découverte : Suivant ne lance aucun calcul. Le jaune désigne la zone à observer.")
    items(83) = Array("TUTORIAL.ACTION.CONFIRM", "Run the following command on your real schedule? It may recalculate and update the project.", "Lancer la commande suivante sur votre vrai planning ? Elle peut recalculer et actualiser le projet.")
    items(84) = Array("TUTORIAL.ACTION.RETRY", "Stay on this step. If the command reported a blocking error, correct it using its messages, then try Next again. Warnings do not block progress.", "Restez à cette étape. Si la commande a signalé une erreur bloquante, corrigez-la à partir de ses messages, puis réessayez Suivant. Les avertissements ne bloquent pas la progression.")
    items(85) = Array("TUTORIAL.RESUME.POLICY", "Resume rechecks available results. Restart affects this mode only.", "La reprise réexamine les résultats disponibles. Recommencer concerne uniquement ce mode.")
    items(86) = Array("TUTORIAL.SCURVE_BUILD.TITLE", "Produce the progress curves", "Produire les courbes d'avancement")
    items(87) = Array("TUTORIAL.SCURVE_BUILD.BODY", "Inputs first\nThe curves use the task dates, {Weight} and {Progress}. Check those WBS inputs before relying on the graph.\n\n{UpdateSCurve}\nThis existing WBS command calculates the curves and opens SCURVE. In Practice, {Next} proposes this command; in Discovery it only explains it.", "D'abord les entrées\nLes courbes utilisent les dates, {Weight} et {Progress}. Vérifiez ces entrées WBS avant de vous appuyer sur le graphique.\n\n{UpdateSCurve}\nCette commande WBS calcule les courbes et ouvre SCURVE. En pratique, {Next} la propose ; en découverte, il l'explique seulement.")
    items(88) = Array("TUTORIAL.FINISH.TITLE", "You can now work independently", "Vous pouvez maintenant travailler en autonomie")
    items(89) = Array("TUTORIAL.FINISH.BODY", "The workflow\nPrepare WBS inputs, update scheduling, then examine the Gantt and progress views. Keep snapshots for future comparisons and use business messages to correct inputs.\n\nCome back when needed\nThe tutorial remains available from the Ribbon. {HomeButton} switches modes without deleting the other bookmark. {FinishButton} marks this mode completed, without saving automatically.", "Le parcours\nPréparez les entrées WBS, actualisez le planning, puis examinez le Gantt et les vues d'avancement. Conservez des instantanés pour vos comparaisons et utilisez les messages métier pour corriger les saisies.\n\nRevenir au besoin\nLe tutoriel reste accessible depuis le ruban. {HomeButton} change de mode sans effacer l'autre progression. {FinishButton} marque ce mode terminé, sans sauvegarde automatique.")
    items(90) = Array("TUTORIAL.RESUME.EMPTY", "Your task list is now empty. Return to task preparation? Your previous bookmark is kept until you accept.", "Votre liste de tâches est maintenant vide. Revenir à la préparation des tâches ? Votre ancien repère est conservé jusqu'à votre accord.")
    items(91) = Array("TUTORIAL.GANTT_BUILD.TITLE", "Build the Gantt from WBS", "Construire le Gantt depuis WBS")
    items(92) = Array("TUTORIAL.GANTT_BUILD.BODY", "{UpdateGantt}\nUse this WBS command to update scheduling and produce the physical Gantt. A pending view is not built just by the tutorial displaying its sheet.\n\nPractice\nNext proposes this command explicitly. When it succeeds, the next page shows the actual result. In Discovery, {Next} never builds it.", "{UpdateGantt}\nUtilisez cette commande WBS pour actualiser le planning et produire le Gantt physique. Le tutoriel ne construit pas une vue en attente simplement en affichant sa feuille.\n\nPratique\nSuivant propose explicitement cette commande. Après sa réussite, la page suivante montre le résultat réel. En découverte, {Next} ne le construit jamais.")
    items(93) = Array("TUTORIAL.ERROR", "The tutorial could not complete this action. Your scheduling inputs were not changed by the visit. {Details}", "Le tutoriel n'a pas pu terminer cette action. La visite n'a pas modifié vos entrées de planning. {Details}")
    items(94) = Array("TUTORIAL.PROGRESS.READONLY", "Read-only: progress is kept for this session only.", "Lecture seule : la progression est conservée uniquement pour cette session.")
    items(95) = Array("TUTORIAL.RESUME.UNCONFIRMED", "Calculation is not confirmed for the current inputs in this session. Return to the calculation step? Resuming does not run a calculation, and your previous bookmark is kept until you accept.", "Le calcul n'est pas confirmé pour les données actuelles dans cette session. Revenir à l'étape de calcul ? La reprise ne lance aucun calcul et conserve votre ancien repère jusqu'à votre accord.")
    items(96) = Array("TUTORIAL.FINANCE.TITLE", "FINANCE: optional cost tracking", "FINANCE : un suivi des coûts facultatif")
    items(97) = Array("TUTORIAL.FINANCE.BODY", _
        "Choose projects and activities\nClick {ManageFinance} to open the selection window. Search by WBS or name and move activities between lists. {AddFinancialProject} creates a named group, independent of the planning hierarchy. {Confirm} applies the whole draft; {Cancel} changes nothing. The tutorial does not open this window automatically.\n\nActivities in several projects\nChoose Unlinked values (empty), Copied (one-time copy) or Linked duplicate (common inputs and expenses, counted once in Global). Later assignments inherit that relationship while at least two active assignments remain.\n\n" & _
        "Blue inputs, grey outputs\nEnter a budget and its distribution. Leave the remaining estimate empty if unknown; enter 0 only when no more spending is expected. WBS progress never determines expenses. With several projects, use the selector: Global is read-only and both Finance sheets show the same scope.\n\n{RefreshFinance}\nRefresh explicitly after changes. Update scheduling first if dates need recalculation. Selecting a project displays its results without updating the last Refresh timestamp. {Next} never calculates. Currency changes display, not exchange rates; choose the Finance language in {Settings}.", _
        "Choisir les projets et activités\nCliquez sur {ManageFinance} pour ouvrir la sélection. Recherchez par WBS ou nom et déplacez les activités entre les listes. {AddFinancialProject} crée un regroupement nommé, indépendant du planning. {Confirm} applique le brouillon ; {Cancel} ne change rien.\n\nUne activité dans plusieurs projets\nChoisissez Valeurs non liées (vides), Copié (copie ponctuelle) ou Dupliqué (saisies et dépenses communes, comptabilisées une fois dans Global). Les ajouts suivants héritent de cette relation tant qu'au moins deux rattachements actifs subsistent.\n\nSaisies bleues, sorties grises\nRenseignez un budget et sa répartition. Laissez le reste estimé vide s'il est inconnu ; saisissez 0 seulement si aucune dépense ne reste à prévoir. L'avancement WBS ne détermine jamais les dépenses. Avec plusieurs projets, Global consolide tous les projets en lecture seule. Les deux feuilles affichent le même périmètre.\n\n" & _
        "{RefreshFinance}\nActualisez explicitement après vos modifications. Recalculez séparément le planning si les dates doivent changer. Changer de projet projette ses résultats sans modifier la date du dernier Refresh. {Next} ne calcule jamais. La devise change l'affichage, pas le taux de change ; choisissez la langue Finance dans {Settings}.")
    items(98) = Array("TUTORIAL.FINANCE_EXPENSES.TITLE", "Record expenses and credit notes", "Saisir les dépenses et les avoirs")
    items(99) = Array("TUTORIAL.FINANCE_EXPENSES.BODY", _
        "Open the temporary table\nChoose an individual project and click {ManageExpenses}. Edit expenses directly in the FINANCE INPUT Excel table. Its filters and sorting work like any Excel table. The small panel leaves other sheets and files accessible. Global is read-only.\n\nEdit or paste\nEnter WBS, Date, Amount and Comment. Add, edit or remove table rows, or paste four columns in that order. A blank row remains available. Negative credits and decimal points or commas are accepted.\n\nCheck future dates\nThe warning lists each expense with its task ID, WBS and date. Entries remain in the journal, but only appear as realized in the chart once their date is reached and you run {RefreshFinance}. Cancel the warning to correct the draft.\n\nConfirm or cancel\n{Confirm} saves the whole draft; {Cancel} discards it. Both return to FINANCE. Linked duplicates share the same entries. Close the draft with one of these buttons before saving the workbook.", _
        "Ouvrir le tableau temporaire\nChoisissez un projet individuel et cliquez sur {ManageExpenses}. Modifiez les dépenses directement dans le tableau Excel FINANCE INPUT, avec ses filtres et tris habituels. Le petit panneau laisse les autres feuilles et fichiers accessibles. Global est en lecture seule.\n\nSaisir ou coller\nRenseignez WBS, Date, Montant et Commentaire. Ajoutez, modifiez ou supprimez des lignes du tableau, ou collez quatre colonnes dans cet ordre. Une ligne vierge reste disponible. Les avoirs négatifs et les décimales avec point ou virgule sont acceptés.\n\n" & _
        "Vérifier les dates futures\nL'avertissement présente chaque dépense avec son ID de tâche, son WBS et sa date. Elle reste au journal, mais n'apparaît dans le réalisé du graphique qu'une fois sa date atteinte et après {RefreshFinance}. Annulez l'avertissement pour corriger le brouillon.\n\nConfirmer ou annuler\n{Confirm} enregistre tout le brouillon ; {Cancel} l'abandonne. Ces deux boutons ramènent sur FINANCE. Les doublons liés utilisent les mêmes écritures. Fermez le brouillon avec l'un de ces boutons avant d'enregistrer le classeur.")
    items(100) = Array("TUTORIAL.FINANCE_SUMMARY.TITLE", "FINANCE SUMMARY: read the results", "FINANCE SUMMARY : lire les résultats")
    items(101) = Array("TUTORIAL.FINANCE_SUMMARY.BODY", _
        "The chart\nCompare budget and dated expenses in the scope selected in FINANCE. Budget covers the full horizon. Realized costs stop at the last explicit Refresh date; the Today marker uses the same reference.\n\nGlobal consolidation\nGlobal is the read-only consolidated view of all financial projects. Linked duplicates count once: a common 10,000 in A and B remains 10,000 in Global. Copied or unlinked records are separate and added normally. Amounts use one Finance currency. Coverage counts distinguish known amounts from unknowns.\n\nThe tables\nRead monthly amounts and WBS totals below the chart. Expand or collapse with Excel outline controls. Grey cells are automatic; widths remain free. Opening this sheet does not refresh it: use {RefreshFinance}.", _
        "Le graphique\nComparez budget et dépenses datées du périmètre choisi dans FINANCE. Le budget couvre tout l'horizon. Le réalisé s'arrête à la date du dernier Refresh explicite ; le repère Aujourd'hui utilise la même référence.\n\nConsolidation Global\nGlobal est la vue consolidée en lecture seule de tous les projets financiers. Un doublon lié compte une fois : les mêmes 10 000 dans A et B restent 10 000 dans Global. Les fiches copiées ou non liées sont distinctes et additionnées. Les montants utilisent une seule devise Finance. Les couvertures distinguent les montants connus des inconnus.\n\nLes tableaux\nLisez les montants mensuels et les totaux WBS sous le graphique. Développez ou réduisez avec le plan Excel. Les cellules grises sont automatiques ; les largeurs restent libres. Ouvrir cet onglet ne l'actualise pas : utilisez {RefreshFinance}.")
    items(102) = Array("TUTORIAL.FINANCE_EXTRACT.TITLE", "Extract a dated expense table", "Extraire un tableau de dépenses horodaté")
    items(103) = Array("TUTORIAL.FINANCE_EXTRACT.BODY", _
        "{ExtractFinance}\nCopy the active scope's expenses into a new numbered sheet, without calculation. Global lists each common entry once, with the names of projects using it. Technical identifiers are not exported. Future entries are included.\n\nA snapshot you can use\nRow 1 gives the timestamp, scope and currency. Headers are on row 2; data starts on row 3. Filter, resize, edit or copy freely. The sheet has no protection or live synchronisation.\n\nEach click, a new extract\nLater changes do not update older extracts. {CleanFinance} and Full Reset delete Finance data and extracts and reset numbering, after confirmation. Import preparation preserves local extracts. {Next} never creates an extract.", _
        "{ExtractFinance}\nCopiez les dépenses du périmètre actif dans un nouvel onglet numéroté, sans calcul. Global présente chaque écriture commune une fois, avec les noms des projets qui l'utilisent. Les identifiants techniques ne sont pas exportés. Les écritures futures sont incluses.\n\nUn instantané exploitable\nLa ligne 1 indique l'horodatage, le périmètre et la devise. Les en-têtes sont en ligne 2 ; les données commencent en ligne 3. Filtrez, redimensionnez, modifiez ou copiez librement. L'onglet n'a ni protection ni synchronisation dynamique.\n\nUn clic, un nouvel extract\nLes modifications ultérieures ne changent pas les anciens extraits. {CleanFinance} et la réinitialisation complète suppriment Finance et ses extraits puis remettent le compteur à zéro, après confirmation. La préparation à l'import conserve les extraits locaux. {Next} ne crée jamais d'extract.")
    items(104) = Array("TUTORIAL.BUTTON_PREFIX", "Button: ", "Bouton : ")
    TextCatalogTutorial_Definitions = items
End Function




