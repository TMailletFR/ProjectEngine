Attribute VB_Name = "mod_TextCatalogFinance"
Option Explicit

Public Function TextCatalogFinance_Definitions() As Variant
    Dim defs As New Collection, fields As Variant, en As Variant, fr As Variant, ee As Variant, fe As Variant
    Dim i As Long, result() As Variant, key As Variant
    fields = Array("WBS", "TASK_NAME", "STATE", "PROGRESS", "BUDGET", "PROFILE", "ACTUAL", "ETC", "EAC", "VARIANCE", "START", "FINISH", "PROJECT", "TASK_ID", "TASK_TYPE", "DIAGNOSTIC", "DATE", "AMOUNT", "COMMENT")
    en = Array("WBS", "Activity", "Status", "WBS progress (%)", "Budget", "Budget timing", "Cost recorded", "Estimated remaining cost", "Estimated final cost", "Expected overspend", "Start", "Finish", "Project", "Task ID", "Activity type", "Diagnostic", "Recorded date", "Amount", "Comment")
    fr = Array("WBS", "Activité", "Statut", "Avancement WBS (%)", "Budget", "Répartition du budget", "Coût constaté", "Coût restant estimé", "Coût final estimé", "Dépassement prévu", "Début", "Fin", "Projet", "Task ID", "Type activité", "Diagnostic", "Date de constat", "Montant", "Commentaire")
    ee = en: fe = fr
    ee(5) = "Accrual profile": fe(5) = "Profil de répartition"
    en(13) = "ID": fr(13) = "ID": ee(13) = "ID": fe(13) = "ID"
    en(9) = "Forecast variance": fr(9) = "Écart prévisionnel"
    ee(6) = "Actual Cost": fe(6) = "Coût réel constaté"
    ee(7) = "ETC - Estimate to Complete": fe(7) = "Reste à dépenser estimé"
    ee(8) = "EAC - Estimate at Completion": fe(8) = "Coût prévisionnel à terminaison"
    ee(9) = "Forecast variance": fe(9) = "Écart prévisionnel"
    For i = 0 To UBound(fields)
        defs.Add Array("FINANCE.COL." & fields(i) & ".BEGINNER", en(i), fr(i))
        defs.Add Array("FINANCE.COL." & fields(i) & ".EXPERT", ee(i), fe(i))
    Next i
    Add defs, "GROUP", "Finance", "Finance"
    Add defs, "INVALID_DOMAIN", "Invalid Finance storage or references. No changes were committed.", "Stockage ou références Finance invalides. Aucune modification validée."
    Add defs, "INVALID_PROFILE", "Choose a valid budget profile: Start, End or Linear.", "Choisissez un profil de répartition valide : Début, Fin ou Linéaire."
    Add defs, "DEFAULT_PROJECT", "My project", "Mon projet"
