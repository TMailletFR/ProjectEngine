    Add defs, "PROJECT_NAME", "Project name", "Nom du projet"
    Add defs, "PROJECT_NAME_INVALID", "Enter a unique project name (1 to 120 characters). Leading/trailing spaces and letter case do not distinguish names.", "Saisissez un nom de projet unique (1 à 120 caractères). Les espaces en début/fin et la casse ne distinguent pas les noms."
    Add defs, "PROJECT_ADD", "Add project", "Ajouter un projet"
    Add defs, "PROJECT_RENAME", "Rename", "Renommer"
    Add defs, "PROJECT_DELETE", "Delete project", "Supprimer le projet"
